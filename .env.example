# -----------------------------------------------------------------------------
# Connection to your existing Gogs instance
# -----------------------------------------------------------------------------
# Base URL of your Gogs server (no trailing slash needed).
GOGS_URL=https://gogs.example.com

# Personal access token. Create one via the Gogs web UI under
# Settings -> Applications (URL: <GOGS_URL>/user/settings/applications,
# even if not linked from a visible menu), or via the API:
#   curl -X POST -u YOUR_USERNAME:YOUR_PASSWORD \
#     -H "Content-Type: application/json" -d '{"name":"gogs-mcp"}' \
#     https://your-gogs-instance/api/v1/users/YOUR_USERNAME/tokens
# The response's "sha1" field is the token value.
GOGS_TOKEN=

# -----------------------------------------------------------------------------
# MCP server configuration
# -----------------------------------------------------------------------------
# Transport: "http" (Streamable HTTP, default, for the Docker deployment)
# or "stdio" (for MCP clients that spawn a local process directly).
MCP_TRANSPORT=http

# Port published on the host (docker-compose maps host:MCP_PORT -> container:8080;
# the server always listens on 8080 inside the container).
MCP_PORT=8080

# Externally reachable base URL of this server (no trailing slash), e.g.
# https://mcp.example.com. Used to build the OAuth protected-resource-metadata
# URL below. Defaults to http://localhost:<MCP_PORT> if unset.
MCP_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Securing the /mcp endpoint - without one of these, anyone who can reach this
# port can call every tool using your configured Gogs credentials.
# -----------------------------------------------------------------------------
# Option A (recommended if you run an OIDC provider, e.g. Keycloak): validate
# bearer tokens as OAuth2 access tokens against this issuer. Set to your
# realm's issuer URL, e.g. https://keycloak.example.com/realms/myrealm - its
# /.well-known/openid-configuration must be reachable from this container.
# Takes priority over MCP_AUTH_TOKEN below when set.
OAUTH_ISSUER=
# Optional: reject tokens whose "aud" claim doesn't match this value.
OAUTH_AUDIENCE=

# Option B (simpler, no OIDC provider needed): a shared secret clients must
# send as "Authorization: Bearer <token>". Only used when OAUTH_ISSUER is
# empty. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# UID/GID the mcp-server container process runs as (build-time, see Dockerfile).
# Leave empty to use the Dockerfile defaults. Rebuild the image after changing
# these (docker compose up -d --build).
GOGS_MCP_UID=
GOGS_MCP_GID=
