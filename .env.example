# -----------------------------------------------------------------------------
# Connection to your existing Gogs instance
# -----------------------------------------------------------------------------
# Base URL of your Gogs server (no trailing slash needed).
GOGS_URL=https://gogs.example.com

# Preferred authentication: a personal access token. Create one via the API
# (works regardless of what your Gogs web UI exposes):
#   curl -X POST -u YOUR_USERNAME:YOUR_PASSWORD \
#     -H "Content-Type: application/json" -d '{"name":"gogs-mcp"}' \
#     https://your-gogs-instance/api/v1/users/YOUR_USERNAME/tokens
# The response's "sha1" field is the token value.
GOGS_TOKEN=

# Fallback authentication if GOGS_TOKEN is left empty: HTTP Basic Auth.
GOGS_USERNAME=
GOGS_PASSWORD=

# -----------------------------------------------------------------------------
# MCP server configuration
# -----------------------------------------------------------------------------
# Transport: "http" (Streamable HTTP, default, for the Docker deployment)
# or "stdio" (for MCP clients that spawn a local process directly).
MCP_TRANSPORT=http
MCP_PORT=8080

# UID/GID the mcp-server container process runs as (build-time, see Dockerfile).
# Leave empty to use the Dockerfile defaults. Rebuild the image after changing
# these (docker compose up -d --build).
GOGS_MCP_UID=
GOGS_MCP_GID=
